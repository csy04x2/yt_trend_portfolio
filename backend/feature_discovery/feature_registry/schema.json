{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental feature registry; not production taxonomy",
  "type": "object",
  "required": ["schema_version", "notice", "features"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1"]},
    "notice": {"$ref": "#/$defs/text"},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "feature": {
      "type": "object",
      "required": ["feature_id", "name", "version", "scope", "value_type", "definition", "inclusion_examples", "exclusion_examples", "required_evidence", "source", "status"],
      "additionalProperties": false,
      "properties": {
        "feature_id": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "value_type": {"type": "string", "enum": ["binary", "categorical", "numeric"]},
        "definition": {"$ref": "#/$defs/text"},
        "inclusion_examples": {"$ref": "#/$defs/examples"},
        "exclusion_examples": {"$ref": "#/$defs/examples"},
        "required_evidence": {"$ref": "#/$defs/examples"},
        "source": {"type": "string", "enum": ["human", "llm", "both", "comment-derived"]},
        "status": {"type": "string", "enum": ["candidate", "testing", "validated", "rejected"]},
        "categories": {"$ref": "#/$defs/examples"}
      }
    }
  }
}
